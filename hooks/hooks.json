{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}\" --frozen --no-sync -- python -I \"${CLAUDE_PLUGIN_ROOT}/src/convoy/interface/hook_guard.py\"",
            "timeout": 1800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}\" --frozen --no-sync -- python -I \"${CLAUDE_PLUGIN_ROOT}/src/convoy/interface/hook_guard.py\"",
            "timeout": 1800
          }
        ]
      }
    ]
  }
}
